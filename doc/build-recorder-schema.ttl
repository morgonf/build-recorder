@prefix : <http://build-recorder.org/data#> .
@prefix b: <http://build-recorder.org/rdf#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Types
b:process a rdfs:Class ;
    rdfs:label "Process" ;
    rdfs:comment "Represents a process." .

b:file a rdfs:Class ;
    rdfs:label "File" ;
    rdfs:comment "Represents a file." .

# Process Properties
b:pid a rdf:Property ;
    rdfs:label "PID" ;
    rdfs:domain b:process ;
    rdfs:range xsd:integer ;
    rdfs:comment "the process ID." .

b:cmd a rdf:Property ;
    rdfs:label "Command" ;
    rdfs:domain b:process ;
    rdfs:range xsd:string ;
    rdfs:comment "The actual command line, obtained by concatenating all arguments separated by white space." .

b:start a rdf:Property ;
    rdfs:label "Process start" ;
    rdfs:domain b:process ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "The start timestamp." .

b:end a rdf:Property ;
    rdfs:label "Process end" ;
    rdfs:domain b:process ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "The end timestamp." .

b:env a rdf:Property ;
    rdfs:label "Environment entry" ;
    rdfs:domain b:process ;
    rdfs:range xsd:string ;
    rdfs:comment "An environment entry in the form of \"VAR=value\"." .

# File Properties
b:name a rdf:Property ;
    rdfs:label "File name" ;
    rdfs:domain b:file ;
    rdfs:range xsd:string ;
    rdfs:comment "The file name." .

b:size a rdf:Property ;
    rdfs:label "File size" ;
    rdfs:domain b:file ;
    rdfs:range xsd:integer ;
    rdfs:comment "The file size in bytes." .

b:hash a rdf:Property ;
    rdfs:label "File checksum" ;
    rdfs:domain b:file ;
    rdfs:range xsd:string ;
    rdfs:comment "A hexadecimal string representing a unique, git-compatible hash of the file's content." .

b:kind a rdf:Property ;
    rdfs:label "File content kind" ;
    rdfs:domain b:file ;
    rdfs:range xsd:string ;
    rdfs:comment "The format of the file's content by its first bytes (elf-rel, elf-exec, elf-dyn, ar, class, zip, gzip, ...), absent for text and unknown formats." .

b:abspath a rdf:Property ;
    rdfs:label "File absolute path" ;
    rdfs:domain b:file ;
    rdfs:range xsd:string ;
    rdfs:comment "The absolute path of the file." .

# Relationships
b:creates a rdf:Property ;
    rdfs:label "Creates" ;
    rdfs:domain b:process ;
    rdfs:range b:process ;
    rdfs:comment "Indicates that a process creates another process." .

b:reads a rdf:Property ;
    rdfs:label "Reads" ;
    rdfs:domain b:process ;
    rdfs:range b:file ;
    rdfs:comment "Indicates that a process reads a file." .

b:writes a rdf:Property ;
    rdfs:label "Writes" ;
    rdfs:domain b:process ;
    rdfs:range b:file ;
    rdfs:comment "Indicates that a process writes a file." .

b:executable a rdf:Property ;
    rdfs:label "Executable" ;
    rdfs:domain b:process ;
    rdfs:range b:file ;
    rdfs:comment "Indicates that a process is an executable file." .

b:rename a rdf:Property ;
    rdfs:label "Rename" ;
    rdfs:domain b:process ;
    rdfs:range b:file ;
    rdfs:comment "Indicates that a process renamed a file." .

b:hardlink a rdf:Property ;
    rdfs:label "Hardlink" ;
    rdfs:domain b:process ;
    rdfs:range b:file ;
    rdfs:comment "Indicates that a process hardlinked a file; the new name shares the exact content (and hash) of the existing inode." .

b:coverage_gap a rdf:Property ;
    rdfs:label "Coverage gap" ;
    rdfs:domain b:process ;
    rdfs:range xsd:string ;
    rdfs:comment "Names a mechanism the process used that can perform file I/O without the syscalls this tracer observes (currently \"io_uring\"). Its reads and writes may be missing from the graph, so no completeness claim holds for this process." .

b:member a rdfs:Class ;
    rdfs:label "Archive member" ;
    rdfs:comment "A member of a static archive (ar), as the object it stands for. Carries b:name (its name in the archive) and b:hash (git-blob hash of its bytes, the same as the extracted object's)." .

b:member_of a rdf:Property ;
    rdfs:label "Member of" ;
    rdfs:domain b:member ;
    rdfs:range b:file ;
    rdfs:comment "The archive a member sits in." .

b:loads_member a rdf:Property ;
    rdfs:label "Loads member" ;
    rdfs:domain b:process ;
    rdfs:range b:member ;
    rdfs:comment "The process loaded this archive member as an object; for a linker, the member went into the link. Seen through gcc's LTO plugin, which reads the header of every object the linker loads, so it is recorded only for a process that read liblto_plugin.so. A linker that read an archive but not the plugin has unknown members, not zero; this is not a coverage gap, since the file layer is complete." .

# Package provenance (added by enrich.py post-processing)
b:rpm_package a rdf:Property ;
    rdfs:label "RPM package (NEVRA)" ;
    rdfs:domain b:file ;
    rdfs:range xsd:string ;
    rdfs:comment "Full RPM package identifier (NAME-VERSION-RELEASE.ARCH) that provides this file." .

b:rpm_name a rdf:Property ;
    rdfs:label "RPM package name" ;
    rdfs:domain b:file ;
    rdfs:range xsd:string ;
    rdfs:comment "RPM package name without version, e.g. openssl-devel." .

b:dep_type a rdf:Property ;
    rdfs:label "Dependency type" ;
    rdfs:domain b:file ;
    rdfs:range xsd:string ;
    rdfs:comment "Role of this file in the build: static_header, dynamic_lib, static_archive, build_tool, project_source, system_runtime, unknown." .
