@prefix : <http://build-recorder.org/data#> .
@prefix b: <http://build-recorder.org/rdf#> .

# Grouped (semicolon-terminated) format fixture.
# Same logical graph as flat.out — used to test format equivalence.

:p0 a b:process ;
    b:pid 200 ;
    b:cmd "make all" ;
    b:start "2024-02-01T08:00:00" ;
    b:end "2024-02-01T08:00:10" ;
    b:creates :p1 .

:p1 a b:process ;
    b:pid 201 ;
    b:cmd "/usr/bin/gcc -o out.o in.c" ;
    b:start "2024-02-01T08:00:01" ;
    b:end "2024-02-01T08:00:05" ;
    b:executable :f0 ;
    b:reads :f1 ;
    b:writes :f2 .

:f0 a b:file ;
    b:abspath "/usr/bin/gcc" ;
    b:name "gcc" ;
    b:size 2000 ;
    b:hash "1111111111111111111111111111111111111111" .

:f1 a b:file ;
    b:abspath "/home/user/project/in.c" ;
    b:name "in.c" ;
    b:size 512 ;
    b:hash "2222222222222222222222222222222222222222" .

:f2 a b:file ;
    b:abspath "/tmp/out.o" ;
    b:name "out.o" ;
    b:size 1024 ;
    b:hash "3333333333333333333333333333333333333333" .
